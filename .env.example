# ============================================================
# Google Maps Platform (Smart Maps / God's Eye View)
# ============================================================
GOOGLE_MAPS_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# Telegram Userbot (GramJS / MTProto) Configuration
# ============================================================
# Obtenha o API ID e API HASH em https://my.telegram.org (App Development Tools)
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"

# String Session gerada após o login com número de telefone real
# Pode ser gerada diretamente pela interface do sistema ou scripts GramJS
TELEGRAM_STRING_SESSION=""

# ID ou Username do Grupo/Canal onde o bot terceiro responde (ex: -1001234567890 ou @meugrupo)
TELEGRAM_CHAT_ID="-1001234567890"

# Username ou ID do Bot do Ecossistema Paralelo BUSCAS PRO (ex: @Hgliopk00bot)
TELEGRAM_CHAT_ID_PRO="@Hgliopk00bot"

# Número de telefone do Telegram com DDI (ex: +5511999999999)
TELEGRAM_PHONE_NUMBER="+5511999999999"

# ============================================================
# Servidor & Produção (Render / Railway / Netlify CORS)
# ============================================================
# Porta dinâmica do servidor (Render/Railway injetam dinamicamente)
PORT=3000

# URL do frontend hospedado na Netlify para liberação de CORS
FRONTEND_URL="https://meu-app.netlify.app"

# Origens permitidas adicionais (separadas por vírgula)
ALLOWED_ORIGINS="https://meu-app.netlify.app,http://localhost:3000,http://localhost:5173"

# ============================================================
# Gateway de Pagamento PIX (UP DEPIX v1 API)
# ============================================================
UPDEPIX_API_KEY="your_updepix_api_key_here"
UPDEPIX_BASE_URL="https://updepix.cc/api/v1"
ADMIN_API_SECRET="your_secure_admin_api_secret_here"
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_secret_here"

# ============================================================
# Firebase Client Configuration (Opcional - sobrescreve firebase-applet-config.json)
# ============================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""


